# GitHub production environment secrets. Do not source or commit real values.
DEPLOY_HOST=web.example.com
DEPLOY_USER=poprako-deploy
DEPLOY_PORT=22
DEPLOY_ROOT=/var/www/poprako-web
DEPLOY_HEALTHCHECK_URL=https://web.example.com/

# Entire contents of the deployment-only private key.
DEPLOY_SSH_PRIVATE_KEY=<multiline-private-key>

# Pre-verified known_hosts line for DEPLOY_HOST and DEPLOY_PORT.
DEPLOY_KNOWN_HOSTS=<verified-known-hosts-line>
