server {
    listen [::]:443 ssl ipv6only=on;
    listen 443 ssl;
    server_name hatsu1ki-lb-site.com;

    root /var/www/poprako-w/current;
    index index.html;

    location = /api {
        proxy_pass http://127.0.0.1:8888/api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8888/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    ssl_certificate /etc/letsencrypt/live/hatsu1ki-lb-site.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hatsu1ki-lb-site.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    listen [::]:80;
    server_name hatsu1ki-lb-site.com;

    return 301 https://$host$request_uri;
}
