{
  "name": "poprako-web",
  "private": true,
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poprako-dev/poprako-web.git"
  },
  "engines": {
    "node": "^26.12",
    "pnpm": "12.11.2"
  },
  "type": "module",
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "@tanstack/react-router": "1.170.39",
    "@zip.js/zip.js": "2.11.1",
    "ag-psd": "31.0.2",
    "browser-image-compression": "2.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "jszip": "3.10.1",
    "lucide-react": "1.48.0",
    "modern-tar": "0.8.4",
    "radix-ui": "1.6.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "simple-wasi-zstd": "0.1.5",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.1",
    "@eslint-react/eslint-plugin": "5.18.7",
    "@eslint/js": "9.39.1",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/postcss": "4.1.18",
    "@tanstack/router-generator": "1.167.38",
    "@tanstack/router-plugin": "1.168.40",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "eslint-plugin-storybook": "10.6.2",
    "globals": "16.5.0",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "postcss": "8.5.28",
    "prettier": "3.6.2",
    "storybook": "10.6.2",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.1.6",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "prepare:dependencies": "node script/prepare-dependencies.ts",
    "prepare:dependencies:check": "node script/prepare-dependencies.ts --check",
    "dev": "pnpm run prepare:dependencies:check && vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "generate": "node script/generate.ts",
    "generate:check": "node script/generate.ts --check",
    "typecheck:app": "tsc -p tsconfig.app.json",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:storybook": "tsc -p tsconfig.storybook.json",
    "typecheck:tool": "tsc -p tsconfig.node.json",
    "typecheck:script": "tsc -p tsconfig.script.json",
    "typecheck": "pnpm run prepare:dependencies:check && pnpm run typecheck:app && pnpm run typecheck:test && pnpm run typecheck:storybook && pnpm run typecheck:tool && pnpm run typecheck:script",
    "lint": "eslint . --max-warnings 0",
    "lint:function-lines": "node linters/function-lines/check.ts",
    "format": "prettier --write src script linters .storybook *.json *.ts *.js *.mjs",
    "format:check": "prettier --check src script linters .storybook *.json *.ts *.js *.mjs",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:storybook": "vitest run --config vitest.storybook.config.ts --project storybook",
    "a11y:prune-baseline": "node script/prune-contrast-baseline.ts",
    "project:check": "node script/check.ts && node script/check-test-inventory.ts",
    "test:script": "vitest run --config vitest.script.config.ts",
    "test:inventory": "node script/check-test-inventory.ts",
    "component:audit": "node script/component-inventory.ts",
    "test:frontend": "pnpm run test:unit && pnpm run test:integration && pnpm run test:storybook",
    "test:translator-undo-browser": "vitest run --config vitest.script.config.ts script/translator-undo-browser.test.ts",
    "test": "pnpm run test:frontend && pnpm run test:script",
    "test:browser-install": "playwright install chromium",
    "test:compress-browser": "node script/test-compress-browser.mjs",
    "test:bounded-browser": "node script/test-bounded-browser.mjs",
    "storybook": "pnpm run prepare:dependencies:check && storybook dev -p 6006",
    "build-storybook": "pnpm run prepare:dependencies:check && storybook build --disable-telemetry",
    "test:storybook-start": "node script/test-storybook-start.ts",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run lint:function-lines && pnpm run project:check && pnpm run generate:check && pnpm run test",
    "audit": "pnpm audit --audit-level high",
    "test:watch": "vitest --config vitest.unit.config.ts"
  }
}
