    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "modern-tar": "^0.8.4",
    "node-liblzma": "5.1.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
