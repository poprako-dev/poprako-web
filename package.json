  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poprako-dev/poprako-web.git"
  },
  "engines": {
    "deno": ">=2.9 <2.10"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "check": "tsc -b && eslint . --max-warnings 0",
    "preview": "vite preview",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "storybook": "deno run -A scripts/storybook-deno.mjs dev -p 6006",
    "test:storybook-start": "sh scripts/test-storybook-start.sh",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
