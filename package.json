    "playwright": "^1.59.1",
    "shadcn": "^3.8.5",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^7.3.2",
    "vite-plugin-react-inspector": "^0.3.3",
    "vitest": "^4.1.4"
